{
  "schema_version": 1,
  "id": "beat-paper",
  "name": "Paper",
  "description": "Serif editorial cards with a warm, square-corner palette.",
  "version": "1.0.1",
  "author": "Beat contributors",
  "license": "MIT",
  "runtime": "declarative",
  "minimum_beat_version": "0.1.0",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "items": [
      {
        "key": "font",
        "options": [
          "serif",
          "system"
        ]
      },
      {
        "key": "detail"
      },
      {
        "key": "show_network"
      }
    ]
  },
  "supported_locales": [
    "en",
    "zh-CN"
  ]
}
