[Unit]
Description=Beat monitoring server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=beat
Group=beat
EnvironmentFile=/etc/beat/beat.env
ExecStart=/opt/beat/current/beat-server -db-path /var/lib/beat/beat.db -mts-path /var/lib/beat/beat_mts -static-dir /opt/beat/current/static -listen-addr :8080
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/beat
ReadWritePaths=/var/lib/beat
ReadWritePaths=/var/lib/.beat-lifecycle-729cd0f7e88680c81c72252f3c1df5c4f2c3f1306e3bb7320c3a530273c4a160.lock
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
